# Copy this file to .env and edit the paths to match your machine.
# .env is gitignored; env.example documents the supported keys.

# Optional: point the build straight at your install media instead of staging
# it into media/. Relative to the repo root, or absolute. Used by build.sh.
VB6_CD=../vb6studio_disk1
VB6_SP6=../VB6_Services_Packs/vs6sp6setup

# Optional: parent dir holding vb6studio_disk1/ and VB6_Services_Packs/.
# Used by scripts/prepare-media.sh as the default --source.
VB6_MEDIA_SOURCE=..
